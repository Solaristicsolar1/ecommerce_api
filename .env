# Environment (e.g., "development" or "production")
ENVIRONMENT="development"

# A secret key for generating secure tokens (we will use this for JWT login later)
# You can generate a random one by running: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-super-secret-random-string-here"

# The PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db"